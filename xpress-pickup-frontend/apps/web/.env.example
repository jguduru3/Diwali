# Copy to .env.local (not committed). Build-time settings for the web app.
# Same domain through Front Door (default):
VITE_API_BASE=/api
# API on another domain (also set webOrigins in infra/params.<env>.json):
# VITE_API_BASE=https://api.example.in/api

# Company website the footer's "Powered by" line links to (empty: https://betteranalytics.in/).
VITE_COMPANY_URL=https://betteranalytics.in/
# Floating game icon and /play link (true/false).
VITE_GAME_ENABLED=true
# Where the game icon and /play go (the BEA game is hosted outside this app).
VITE_GAME_URL=https://bea-game.betteranalytics.in/
